# Copy to your server environment (or a local .env that you load yourself).
# Never commit real keys. .env is already git-ignored at the repo root.

# Leave unset to use mock data (no network calls). Set it to switch to live odds.
ODDS_API_KEY=

# Optional
# ODDS_PROVIDER=mock            # force mock data even when a key is set
# ODDS_API_BASE_URL=https://api.odds-api.net/v1
# PORT=4173
# HOST=127.0.0.1
