# Server-side settings. Set them in your shell or your host's dashboard
# (Render asks for the secret ones). Never commit real values.

# Leave unset to use mock data (no network calls). Set it for live odds.
ODDS_API_KEY=

# Require a password for the whole site (any username). Recommended whenever
# the dashboard is reachable from the internet.
DASHBOARD_PASSWORD=

# Optional
# ODDS_PROVIDER=mock            # force mock data even when a key is set
# ODDS_API_BASE_URL=https://api.odds-api.net/v1
# PORT=4173
# HOST=127.0.0.1                # use 0.0.0.0 on a host like Render
# TRUST_PROXY=1                 # behind a hosting proxy (Render sets this)
